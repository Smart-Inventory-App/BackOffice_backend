DATABASE_URL=postgresql://user:password@localhost:5432/tpp_db

# Servicio de autenticación (los admins se loguean acá, igual que la app)
AUTH_SERVICE_URL=http://localhost:8001

# JWT compartido con auth y app_backend (el backoffice solo valida tokens emitidos por auth)
JWT_SECRET=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256

# CORS — orígenes del frontend del backoffice
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# Servicio de almacenamiento de imágenes (las fotos de producto se suben como archivo)
IMAGE_STORAGE_URL=http://localhost:8004
MAX_IMAGE_MB=10

# Coordinador del módulo de OCR
OCR_SERVICE_URL= #URL
OCR_TIMEOUT_SECONDS=300

# En producción va en False
DEBUG=False

HOST=0.0.0.0
PORT=8002
