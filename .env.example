# Shared platform database (same tpp_db used by auth and app_backend)
DATABASE_URL=postgresql://user:password@localhost:5432/tpp_db

# Dedicated JWT secret for admin sessions (independent from app users)
ADMIN_JWT_SECRET=admin-secret-change-in-production
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXPIRE_MINUTES=120

# CORS — origins of the backoffice frontend
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:5173

DEBUG=True
HOST=0.0.0.0
PORT=8002
